{
  "name": "permafrost-desktop",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config desktop/vite.config.ts",
    "build": "tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "test": "vitest run --config desktop/vite.config.ts",
    "test:e2e": "playwright test --config desktop/playwright.config.ts",
    "tauri": "tauri",
    "check": "npm run build && npm test && cargo test -p permafrost-core"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "lucide-react": "^0.468.0",
    "occt-import-js": "0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "6.4.4",
    "vitest": "^4.1.12"
  }
}
